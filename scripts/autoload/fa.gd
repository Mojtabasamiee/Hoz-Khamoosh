# ---------- Persian digits helper ----------
static func to_fa_num(s: String) -> String:
        var fa := "۰۱۲۳۴۵۶۷۸۹"
        var out := ""
        for c in s:
                if c >= "0" and c <= "9":
                        out += fa[int(c)]
                else:
                        out += c
        return out
